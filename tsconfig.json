{
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/pages/**/*.tsx",
    "src/components/DrumTrackVisualizer.tsx",
    "src/components/Button.tsx",
    "src/components/Badge.tsx",
    "src/components/ThemeToggle.tsx",
    "src/hooks/useSpotifyAuth.ts"
  ],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  }
}